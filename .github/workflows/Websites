<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:
radial-gradient(circle at top,#500000 0%,#0a0a0a 40%),
linear-gradient(to bottom,#050505,#111);
color:white;
overflow-x:hidden;
}

.header{
display:flex;
