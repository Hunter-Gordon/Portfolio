</style>
</head>

<body>

<div class="header">
<div class="logo">GCL POWER</div>
<button class="settings" onclick="login()">⚙</button>
</div>

<div id="homePage">
<div class="hero">
<h1>POWER<br>RANKINGS</h1>
<p>Elite Ohio High School Rankings</p>

<div class="genderGrid">
<button class="genderBtn boys" onclick="openSports('Boys')">BOYS</button>
<button class="genderBtn girls" onclick="openSports('Girls')">GIRLS</button>
</div>

</div>
</div>

<div id="sportsPage" class="page hidden">
<button class="back" onclick="goHome()">Back</button>
<h1 class="pageTitle">Select Sport</h1>
<div class="grid" id="sportsList"></div>
</div>

<div id="rankingsPage" class="page hidden">
<button class="back" onclick="backSports()">Back</button>
<h1 class="pageTitle" id="rankingTitle"></h1>

<select id="yearSelect" onchange="renderRankings()"></select>

<table class="rankTable">
<thead>
<tr>
<th>Rank</th>
<th>School</th>
<th>Record</th>
<th>Conference</th>
<th>Win Percent</th>
<th>Rating</th>
</tr>
</thead>
<tbody id="rankingsBody"></tbody>
</table>
</div>

<div id="adminPage" class="page hidden">
<button class="back" onclick="goHome()">Exit</button>

<h1 class="pageTitle">Admin Panel</h1>

<div class="adminPanel">

<div id="ownerTools" class="hidden">

<div class="sectionTitle">Owner Controls</div>

<input id="newSport" placeholder="New Sport">
<select id="newGender">
<option>Boys</option>
<option>Girls</option>
<option>Both</option>
</select>

<button class="saveBtn" onclick="addSport()">Add Sport</button>

<div class="sectionTitle">Sports Management</div>
<div id="sportsAdminList"></div>

<div class="sectionTitle">Admin Accounts</div>

<input id="newAdminUser" placeholder="New Admin Username">
<input id="newAdminPass" placeholder="Password">
<button class="saveBtn" onclick="addAdmin()">Create Admin</button>

<div id="adminListBox"></div>

<div class="sectionTitle">Log Book</div>
<div class="logBox" id="logs"></div>

<div class="sectionTitle">Add School</div>

<input id="schoolName" placeholder="School Name">
<input id="record" placeholder="Record">
<input id="conferenceRecord" placeholder="Conference Record">
<input id="streak" placeholder="Streak">
<input id="previous" placeholder="Previous Rating">
<input id="year" placeholder="Year">

<select id="gender">
<option>Boys</option>
<option>Girls</option>
</select>

<select id="sport"></select>

<button class="saveBtn" onclick="addSchool()">Add School</button>

</div>

<div class="sectionTitle">Edit Schools</div>
<div id="adminList"></div>

</div>
</div>

<script>

let currentGender=""
let currentSport=""
let role=""

let sports=JSON.parse(localStorage.getItem("sports")||"[]")
let schools=JSON.parse(localStorage.getItem("schools")||"[]")
let logs=JSON.parse(localStorage.getItem("logs")||"[]")
let admins=JSON.parse(localStorage.getItem("admins")||"[{\"u\":\"staff1\",\"p\":\"staff123\"}]")

function save(){
localStorage.setItem("sports",JSON.stringify(sports))
localStorage.setItem("schools",JSON.stringify(schools))
localStorage.setItem("logs",JSON.stringify(logs))
localStorage.setItem("admins",JSON.stringify(admins))
}

function log(msg,user){
logs.unshift("["+(user||"system")+"] "+msg)
save()
renderLogs()
}

function renderLogs(){
document.getElementById("logs").innerHTML=logs.slice(0,30).join("<br>")
}

function calcPct(r){
if(!r) return 0
let parts=String(r).replace(/[^0-9 ]/g," ").trim().split(" ")
let w=Number(parts[0])||0
let l=Number(parts[1])||0
return Math.round((w/(w+l||1))*100)
}

function calcRating(w,c,s,p){
w=Number(w)||0
c=Number(c)||0
s=Number(s)||0
p=Number(p)||0
let r=w*0.75+c*0.15+s*1.5+p*0.1
if(r>100)r=100
if(r<10)r=10
return Math.round(r)
}

function openSports(g){
currentGender=g
document.getElementById("homePage").classList.add("hidden")
document.getElementById("sportsPage").classList.remove("hidden")

let html=""
sports.forEach(s=>{
if(s.gender==="Both"||s.gender===g){
html+=`<div class="card" onclick="openRankings('${s.name}')">${s.name}</div>`
}
})
document.getElementById("sportsList").innerHTML=html
}

function openRankings(s){
currentSport=s
document.getElementById("sportsPage").classList.add("hidden")
document.getElementById("rankingsPage").classList.remove("hidden")
document.getElementById("rankingTitle").innerText=currentGender+" "+s

let years=[...new Set(schools.map(x=>x.year||"2026"))]
document.getElementById("yearSelect").innerHTML=years.map(y=>`<option>${y}</option>`).join("")
renderRankings()
}

function renderRankings(){
let y=document.getElementById("yearSelect").value||"2026"

let list=schools.filter(x=>x.gender===currentGender&&x.sport===currentSport&&(x.year||"2026")===y)

list.sort((a,b)=>calcPct(b.record)-calcPct(a.record))

document.getElementById("rankingsBody").innerHTML=list.map((x,i)=>{
let w=calcPct(x.record)
let c=calcPct(x.conferenceRecord)
let s=+x.streak||0
let p=+x.previous||0
let r=calcRating(w,c,s,p)

return `<tr>
<td class="rankNum">${i+1}</td>
<td>${x.name}</td>
<td>${x.record}</td>
<td>${x.conferenceRecord}</td>
<td>${w}%</td>
<td class="rating">${r}</td>
</tr>`
}).join("")
}

function login(){
let u=prompt("Username")
let p=prompt("Password")

let found=admins.find(a=>a.u===u&&a.p===p)

if(found){
role=u
openAdmin()
return
}

if(u==="gordonh15769"&&p==="hunhedg6"){
role="owner"
openAdmin()
return
}

alert("Wrong login")
}

function openAdmin(){
document.getElementById("adminPage").classList.remove("hidden")

if(role==="owner"){
document.getElementById("ownerTools").classList.remove("hidden")
renderAdminSports()
renderAdminAccounts()
populateSportDropdown()
}

renderAdmin()
renderLogs()
}

function renderAdmin(){

let html=""

schools.forEach((s,i)=>{
html+=`
<div class="schoolBlock">

<div><b>${s.name}</b> ${s.sport}</div>

<div class="editGrid">

<div>
<div>Record</div>
<input value="${s.record}" onchange="updateSchool(${i},'record',this.value)">
</div>

<div>
<div>Conference Record</div>
<input value="${s.conferenceRecord}" onchange="updateSchool(${i},'conferenceRecord',this.value)">
</div>

<div>
<div>Streak</div>
<input value="${s.streak}" onchange="updateSchool(${i},'streak',this.value)">
</div>

<div>
<div>Previous Rating</div>
<input value="${s.previous}" onchange="updateSchool(${i},'previous',this.value)">
</div>

<div>
<div>Year</div>
<input value="${s.year}" onchange="updateSchool(${i},'year',this.value)">
</div>

</div>

${role==="owner" ? `<button class="smallBtn" onclick="deleteSchool(${i})">Delete School</button>` : ""}

</div>
`
})

document.getElementById("adminList").innerHTML=html
}

function updateSchool(i,key,val){
schools[i][key]=val
save()
log(role+" edited "+schools[i].name+" "+key,role)
renderAdmin()
renderRankings()
}

function deleteSchool(i){
if(role!=="owner") return
let name=schools[i].name
schools.splice(i,1)
save()
log("owner deleted school "+name,"owner")
renderAdmin()
renderRankings()
}

function addSport(){
sports.push({name:newSport.value,gender:newGender.value})
save()
renderAdminSports()
populateSportDropdown()
}

function renderAdminSports(){
let html=""
sports.forEach((s,i)=>{
html+=`
<div class="schoolBlock">
${s.name} ${s.gender}
<button class="smallBtn" onclick="deleteSport(${i})">Delete</button>
</div>
`
})
document.getElementById("sportsAdminList").innerHTML=html
}

function deleteSport(i){
if(role!=="owner") return
let name=sports[i].name
sports.splice(i,1)
save()
log("owner deleted sport "+name,"owner")
renderAdminSports()
populateSportDropdown()
}

function addAdmin(){
admins.push({u:newAdminUser.value,p:newAdminPass.value})
save()
renderAdminAccounts()
log("owner created admin "+newAdminUser.value,"owner")
}

function renderAdminAccounts(){
let html=""
admins.forEach((a,i)=>{
html+=`
<div class="schoolBlock">
${a.u}
<button class="smallBtn" onclick="deleteAdmin(${i})">Delete</button>
</div>
`
})
document.getElementById("adminListBox").innerHTML=html
}

function populateSportDropdown(){

document.getElementById("sport").innerHTML=
sports.map(s=>`<option value="${s.name}">${s.name}</option>`).join("")

}

function deleteAdmin(i){
admins.splice(i,1)
save()
renderAdminAccounts()
}

function addSchool(){

schools.push({
id:Date.now(),
name:document.getElementById("schoolName").value,
record:document.getElementById("record").value,
conferenceRecord:document.getElementById("conferenceRecord").value,
streak:document.getElementById("streak").value,
previous:document.getElementById("previous").value,
sport:document.getElementById("sport").value,
gender:document.getElementById("gender").value,
year:document.getElementById("year").value || "2026"
})

save()

log(role+" added school "+document.getElementById("schoolName").value,role)

renderAdmin()
renderRankings()

}

function goHome(){location.reload()}

function backSports(){
document.getElementById("rankingsPage").classList.add("hidden")
document.getElementById("sportsPage").classList.remove("hidden")
}

</script>

</body>
</html>
